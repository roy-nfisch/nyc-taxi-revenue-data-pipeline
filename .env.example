# Compose settings only. Copy to .env on your Mac, in the repository root.
PREFECT_PORT=4205
# Optional published image after an approved GHCR release; local builds remain default.
# Leave TAXI_IMAGE commented out for local builds. To switch back, comment it
# out in .env and run `unset TAXI_IMAGE` in your terminal before rebuilding.
# TAXI_IMAGE=ghcr.io/roy-nfisch/nyc-taxi-revenue-data-pipeline:YYYY.MM.DD
# Optional with compose.config.yaml; defaults to the existing file shown below.
# TAXI_CONFIG_FILE=./src/green_taxi/defaults.json
